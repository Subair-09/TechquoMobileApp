# Environment Configuration Template
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/techquo?retryWrites=true&w=majority
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here
JWT_EXPIRES_IN=7d

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Super Administrator Setup Credentials
INITIAL_ADMIN_NAME=Super Admin
INITIAL_ADMIN_EMAIL=admin@techquo.news
INITIAL_ADMIN_PASSWORD=your_secure_admin_password

# Resend Email Verification Configuration
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=TechQuo News <onboarding@resend.dev>
